      "code": "<style>\n  /* Hide the iframe scrollbar while preserving normal scrolling. */\n  html,\n  body {\n    margin: 0;\n    padding: 0;\n    scrollbar-width: none;\n  }\n\n  html::-webkit-scrollbar,\n  body::-webkit-scrollbar {\n    display: none;\n  }\n\n  .th-showcase {\n    --th-dark: #101012;\n    --th-light: #faf9f7;\n    --th-accent: #a65323;\n\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 100%;\n    padding: clamp(16px, 4vw, 44px);\n    background: linear-gradient(\n      to bottom,\n      var(--th-dark) 0%,\n      var(--th-dark) 78%,\n      var(--th-light) 78%,\n      var(--th-light) 100%\n    );\n    color: #171719;\n    font-family: Arial, Helvetica, sans-serif;\n    text-align: center;\n  }\n\n  .th-showcase *,\n  .th-showcase *::before,\n  .th-showcase *::after {\n    box-sizing: inherit;\n  }\n\n  .th-showcase:focus-visible {\n    outline: 2px solid #bc814e;\n    outline-offset: -3px;\n  }\n\n  .th-showcase .th-inner {\n    width: 100%;\n    max-width: 64rem;\n    margin-inline: auto;\n    border-top: 1px solid #38383b;\n  }\n\n  .th-showcase .th-plaque {\n    width: min(68%, 16rem);\n    margin: clamp(48px, 10vw, 100px) auto;\n    padding: 0 clamp(10px, 2vw, 20px) clamp(18px, 3vw, 30px);\n    border: 2px solid #eee8df;\n    background: #242021;\n    color: #fffaf3;\n  }\n\n  .th-showcase .th-ribbon {\n    width: 49%;\n    margin: -10px auto 18px;\n    padding: 2px;\n    background: #eee8df;\n    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);\n  }\n\n  .th-showcase .th-monogram {\n    display: grid;\n    min-height: clamp(76px, 15vw, 118px);\n    place-items: center;\n    padding-bottom: 16%;\n    background: #242021;\n    clip-path: polygon(0 0, 100% 0, 100% 98%, 50% 80%, 0 98%);\n    font: normal clamp(28px, 6vw, 46px)/1 Georgia, serif;\n    letter-spacing: -.08em;\n  }\n\n  .th-showcase .th-brand,\n  .th-showcase .th-concept,\n  .th-showcase .th-location {\n    margin: 0;\n    font-size: .7rem;\n    font-weight: 700;\n    line-height: 1.5;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n\n  .th-showcase .th-award {\n    margin: 12px 0 16px;\n    font: normal clamp(1.6rem, 5vw, 2.6rem)/1.04 Georgia, serif;\n  }\n\n  .th-showcase .th-concept {\n    display: inline-block;\n    padding-top: 9px;\n    border-top: 1px solid #82766b;\n    color: #e2cdb7;\n    letter-spacing: .08em;\n  }\n\n  .th-showcase .th-card {\n    width: 100%;\n    max-width: 56rem;\n    margin-inline: auto;\n    padding: clamp(28px, 5vw, 52px) clamp(18px, 5vw, 58px);\n    border-radius: clamp(16px, 2.5vw, 28px);\n    background: #fff;\n    box-shadow: 0 10px 28px rgb(18 16 14 / 9%);\n  }\n\n  .th-showcase .th-location {\n    color: var(--th-accent);\n    letter-spacing: .2em;\n  }\n\n  .th-showcase .th-heading {\n    max-width: 19em;\n    margin: .65em auto .85em;\n    font-size: clamp(1.65rem, 4.5vw, 3rem);\n    font-weight: 500;\n    line-height: 1.16;\n    letter-spacing: -.045em;\n    text-wrap: balance;\n  }\n\n  .th-showcase .th-heading em {\n    color: var(--th-accent);\n    font-family: Georgia, serif;\n    font-weight: 400;\n  }\n\n  .th-showcase .th-stat {\n    margin: 0;\n  }\n\n  .th-showcase .th-number {\n    display: block;\n    font: normal clamp(2.5rem, 6vw, 4rem)/1.1 Georgia, serif;\n  }\n\n  .th-showcase .th-label {\n    display: block;\n    margin-top: 5px;\n    color: #585359;\n    font-size: 1rem;\n    line-height: 1.5;\n  }\n</style>\n\n<section\n  class=\"th-showcase\"\n  aria-label=\"True Homes in Siliguri\"\n  tabindex=\"0\"\n  lang=\"en\"\n>\n  <div class=\"th-inner\">\n    <figure class=\"th-plaque\">\n      <div class=\"th-ribbon\" aria-hidden=\"true\">\n        <span class=\"th-monogram\">TH</span>\n      </div>\n      <figcaption>\n        <p class=\"th-brand\">True Homes</p>\n        <p class=\"th-award\">Siliguri<br>Property<br>Award</p>\n        <p class=\"th-concept\">Concept award</p>\n      </figcaption>\n    </figure>\n\n    <div class=\"th-card\">\n 